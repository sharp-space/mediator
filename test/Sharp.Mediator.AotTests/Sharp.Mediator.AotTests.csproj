<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Dependency-free NativeAOT canary: proves the library publishes clean and runs under NativeAOT.
             A hand-rolled exe (not a unit-test host) on purpose — xunit v3 cannot pass a strict AOT gate
             (TrimMode=full + warn-as-error): its own infrastructure emits IL3000/IL2070-2080/IL3050. -->
        <PublishAot>true</PublishAot>
        <TrimMode>full</TrimMode>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <InvariantGlobalization>true</InvariantGlobalization>

        <IsTestProject>false</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Sharp.Mediator/Sharp.Mediator.csproj" />
        <ProjectReference Include="../../src/Sharp.Mediator.Responses/Sharp.Mediator.Responses.csproj" />
        <ProjectReference Include="../../src/Sharp.Mediator.Validation/Sharp.Mediator.Validation.csproj" />
        <ProjectReference Include="../Sharp.Mediator.LibraryFixtures/Sharp.Mediator.LibraryFixtures.csproj" />
        <ProjectReference Include="../Sharp.Mediator.NoGeneratorFixtures/Sharp.Mediator.NoGeneratorFixtures.csproj" />
    </ItemGroup>

</Project>
