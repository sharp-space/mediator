        <ProjectReference Include="../Sharp.Mediator.ScaleFixtures/Sharp.Mediator.ScaleFixtures.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

</Project>
